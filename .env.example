# Sanity CMS (get from sanity.io/manage after creating a project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# For Sanity Studio (same project ID)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Facebook Page feed (never-expiring Page token)
# 1. Create a Meta app → Settings → Basic → copy App ID + App Secret
# 2. Graph API Explorer → pages_show_list + pages_read_engagement → Generate User Token
# 3. npm run facebook:token -- <that-user-token>
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Optional payment popup overrides (homepage /#pay)
# NEXT_PUBLIC_ETRANSFER_EMAIL=rhoda@frontporchflowers.ca
# NEXT_PUBLIC_CONTACT_PHONE=+15064253850
